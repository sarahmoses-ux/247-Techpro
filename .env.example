# Official deployed origin (no trailing path). Set before production build.
VITE_SITE_URL=

# HTTPS endpoint that accepts JSON POST and confirms delivery with { "success": true }.
# Leave blank to use the explicit email handoff. Never put secret API keys here.
VITE_LEAD_ENDPOINT=

# Server-only Vercel settings for the /api/repairs function.
# Copy the outgoing server and port from cPanel > Email Accounts > Connect Devices.
# Never prefix these variables with VITE_. Add the mailbox password privately in Vercel.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=info@247techpro.com.ng
SMTP_PASS=
